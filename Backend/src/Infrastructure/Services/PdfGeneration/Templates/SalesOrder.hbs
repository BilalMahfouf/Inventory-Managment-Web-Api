<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sales Order</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
        h1 { color: #1a56db; border-bottom: 2px solid #1a56db; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th { background: #f3f4f6; text-align: left; padding: 8px 12px; border: 1px solid #d1d5db; }
        td { padding: 8px 12px; border: 1px solid #d1d5db; }
        .total { font-weight: bold; font-size: 1.1em; margin-top: 20px; text-align: right; }
        .footer { margin-top: 40px; font-size: 0.85em; color: #6b7280; text-align: center; }
    </style>
</head>
<body>
    <h1>Sales Order</h1>
    <p><strong>Order ID:</strong> {{OrderId}}</p>
    <p><strong>Customer:</strong> {{CustomerName}}</p>
    <p><strong>Date:</strong> {{OrderDate}}</p>
    <p><strong>Status:</strong> {{Status}}</p>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {{#Items}}
            <tr>
                <td>{{ProductName}}</td>
                <td>{{Quantity}}</td>
                <td>{{UnitPrice}}</td>
                <td>{{TotalPrice}}</td>
            </tr>
            {{/Items}}
        </tbody>
    </table>

    <div class="total">
        Total Amount: {{TotalAmount}}
    </div>

    <div class="footer">
        Generated by Inventory Management System
    </div>
</body>
</html>
